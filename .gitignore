# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (secrets - only .env.example should ever be committed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database (generated by `npm run db:push` + `npm run db:seed`)
domiify.db
domiify.db-shm
domiify.db-wal
*.db-journal
# database backups (created by migrate-v2 script)
*.pre-v2-backup.db
# temp migration scripts
scripts/run-migrate.js
